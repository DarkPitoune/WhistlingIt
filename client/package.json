{
  "name": "whistlingit-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "clip": "node scripts/render-whistle.mjs",
    "check:match": "node scripts/check-match.mjs",
    "check:play-flow": "node scripts/check-play-flow.mjs",
    "check:backfill": "node --import ./scripts/ts-resolve.mjs scripts/check-backfill.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}

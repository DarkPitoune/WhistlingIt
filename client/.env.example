# Copy to .env.local and fill in. Vite loads .env.local automatically and it is
# gitignored; .env is not, so don't put values there.
#
# With both Supabase values set, the app talks to the real backend. With either
# missing it falls back to src/api/mock.ts, so a fresh clone runs with no setup.

# ─────────────────────────────────────────────────────── the daily
# `supabase status` for the local stack, or for the linked project:
#   supabase projects api-keys --project-ref ooknrfvatzjpoxedostm
#
# Local:  http://127.0.0.1:54321
# Linked: https://ooknrfvatzjpoxedostm.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# The anon / publishable key. Public by design — an identifier, not a secret. The
# only thing it can reach is get_daily(); the songs and daily tables deny it
# outright, so there is no future puzzle to walk.
#
# NEVER put the service key in a VITE_ variable. Every VITE_ value is baked into
# the shipped JavaScript bundle. The service key belongs on the ingest API only.
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────── the booth
# The ingest API (server/api, deployed to Render). Only the booth uses it, and
# leaving it empty just disables uploading — the daily is unaffected by design.
VITE_INGEST_URL=http://127.0.0.1:8000

# ─────────────────────────────────────────────────────── one caveat
# Vite loads .env.local for production builds too. It is gitignored, so a CI or
# Pages build never sees it — but a local `npm run build` will bake whatever is
# in it into dist/, local URLs included.

# Copy to .env for local runs. Never commit the real values.
#
# Project settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses RLS, which is why the
# tables can have zero policies. It belongs in Render's env and nowhere else.
SUPABASE_SERVICE_KEY=

# Comma-separated origins allowed to POST /uploads. Unset means "*".
ALLOWED_ORIGINS=https://darkpitoune.github.io,http://localhost:8080
